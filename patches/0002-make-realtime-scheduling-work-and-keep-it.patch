Subject: make realtime scheduling work, and keep it after a script runs
Date: 2026-10-13
Applies-to: keepalived 2.4.3

keepalived moves a process to realtime scheduling with sched_setscheduler()
for vrrp_rt_priority, checker_rt_priority, bfd_rt_priority and
max_auto_priority. That code has three faults, and this patch fixes all three.

musl's sched_setscheduler() never calls the kernel and always fails with
ENOSYS, because the Linux system call acts on one thread where POSIX defines
it for a whole process. The image is built on Alpine, which uses musl, so
every realtime setting failed with "cannot raise priority" and
vrrp_rlimit_rttime and checker_rlimit_rttime never took effect. The patch
makes the system call directly, which is what glibc's wrapper does.

With max_auto_priority set, a timer that fires late makes
increment_process_priority() record a higher realtime priority before it
tries to set it. It keeps that value when the switch fails, logs "Set
realtime priority" anyway, and goes on treating the process as realtime. On
musl every script child forked after that also fails to undo the switch that
never happened, and logs "child process: cannot reset realtime scheduling"
once per script run for as long as the process lives. The patch records the
priority, and logs the line, only when the switch succeeded.

A forked script child still holds its parent's pid in our_pid, and acts on
it twice. Its reset of realtime scheduling moves the parent back to normal
scheduling at the first track, notify or MISC_CHECK script, on any C library
and with no log line. And when a script that keepalived runs through system()
is killed by a signal, the child passes that signal on with kill(our_pid), so
the parent VRRP or checker process receives it instead. SIGTERM stops that
process until keepalived respawns it. SIGHUP makes it reload, which runs the
script again at once. The patch sets our_pid to the child's own pid first
thing in the child, which fixes both.

Moving to realtime still needs CAP_SYS_NICE. Without it each switch fails
with one "cannot raise priority" line and the process runs at normal
priority.

Upstream merged all three after 2.4.3: the our_pid fix in
https://github.com/acassen/keepalived/pull/2733, the musl and bookkeeping
fixes in https://github.com/acassen/keepalived/pull/2736 (master 175d268a).
Drop this patch once a pinned release carries them.

--- a/lib/notify.c
+++ b/lib/notify.c
@@ -249,6 +249,7 @@
 	}
 
 	/* Child process */
+	our_pid = getpid();
 	reset_process_priorities();
 
 #ifdef _MEM_CHECK_
--- a/lib/process.c
+++ b/lib/process.c
@@ -24,6 +24,7 @@
 
 #include <sys/mman.h>
 #include <sys/resource.h>
+#include <sys/syscall.h>
 #ifndef RLIMIT_RTTIME
 /* musl was very late defining RLIMIT_RTTIME, not until v1.20 */
 #define RLIMIT_RTTIME	15
@@ -136,6 +137,18 @@
 	cur_priority = 0;
 }
 
+/* musl's sched_setscheduler() always fails with ENOSYS, see
+ * https://git.musl-libc.org/cgit/musl/tree/src/sched/sched_setscheduler.c */
+static int
+set_process_scheduler(int policy, int priority)
+{
+	struct sched_param sp = {
+		.sched_priority = priority
+	};
+
+	return (int)syscall(SYS_sched_setscheduler, our_pid, policy, &sp);
+}
+
 /* NOTE: This function generates a "stack protector not protecting local variables:
    variable length buffer" warning */
 RELAX_STACK_PROTECTOR_START
@@ -148,11 +161,7 @@
 
 	if (realtime_priority) {
 		/* Set realtime priority */
-		struct sched_param sp = {
-			.sched_priority = realtime_priority
-		};
-
-		if (sched_setscheduler(our_pid, SCHED_RR | SCHED_RESET_ON_FORK, &sp))
+		if (set_process_scheduler(SCHED_RR | SCHED_RESET_ON_FORK, realtime_priority))
 			log_message(LOG_WARNING, "child process: cannot raise priority");
 		else {
 			cur_rt_priority = realtime_priority;
@@ -190,12 +199,7 @@
 reset_priority(void)
 {
 	if (cur_rt_priority) {
-		/* Set realtime priority */
-		struct sched_param sp = {
-			.sched_priority = 0
-		};
-
-		if (sched_setscheduler(our_pid, SCHED_OTHER, &sp))
+		if (set_process_scheduler(SCHED_OTHER, 0))
 			log_message(LOG_WARNING, "child process: cannot reset realtime scheduling");
 		else {
 			cur_rt_priority = 0;
@@ -259,8 +263,7 @@
 		/* We are currently using realtime */
 		if (!realtime_priority && max_realtime_priority == -1) {
 			/* Turn off rt_sched and set process_priority */
-			struct sched_param sp = { .sched_priority = process_priority };
-			sched_setscheduler(our_pid, SCHED_OTHER, &sp);
+			set_process_scheduler(SCHED_OTHER, process_priority);
 			cur_rt_priority = 0;
 			max_rt_priority = 0;
 		} else {
@@ -300,6 +303,8 @@
 void
 increment_process_priority(void)
 {
+	unsigned new_priority;
+
 	if (!max_rt_priority)
 		return;
 
@@ -307,15 +312,17 @@
 		if (cur_rt_priority >= max_rt_priority)
 			return;
 
-		cur_rt_priority++;
+		new_priority = cur_rt_priority + 1;
 	} else
-		cur_rt_priority = sched_get_priority_min(SCHED_RR);
+		new_priority = sched_get_priority_min(SCHED_RR);
 
-	set_process_priorities(cur_rt_priority, -1, 0,
+	/* set_process_priorities() updates cur_rt_priority only on success */
+	set_process_priorities(new_priority, -1, 0,
 			       cur_rlimit_rttime ? 0 : default_rlimit_rttime,
 			       0, 0);
 
-	log_message(LOG_INFO, "Set realtime priority %u", cur_rt_priority);
+	if (cur_rt_priority == new_priority)
+		log_message(LOG_INFO, "Set realtime priority %u", cur_rt_priority);
 }
 
 unsigned __attribute__((pure))
